# CivicPulse Backend Environment Configuration (MongoDB Atlas & Security)

# MongoDB Atlas Connection URI (Never commit your real credentials or username:password)
# Format: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=CivicPulse

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial Bootstrap Administrator (created idempotently on first startup)
ADMIN_BOOTSTRAP_EMAIL=admin@city.gov
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_bootstrap_password
ADMIN_BOOTSTRAP_NAME=Commissioner R. Varma
ADMIN_BOOTSTRAP_CITY=Vijayawada
ADMIN_BOOTSTRAP_DEPARTMENT=Municipal Administration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
